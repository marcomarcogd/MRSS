# Dockerfile for building MRSS server version
# This creates a minimal server binary without GUI dependencies

# Build stage
FROM golang:1.25-alpine AS builder

# Install git, Node.js, and build tools (needed for frontend build and CGO)
RUN apk add --no-cache git nodejs npm gcc musl-dev pkgconfig

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build frontend
RUN cd frontend && npm install && npm run build

# Build the server version
RUN CGO_ENABLED=1 GOOS=linux go build -tags server -trimpath -buildvcs=false -ldflags="-w -s" -o mrss-server ./main-core.go

# Runtime stage - minimal alpine image
FROM alpine:latest

LABEL org.opencontainers.image.title="MRSS" \
      org.opencontainers.image.description="A modern, privacy-focused RSS reader" \
      org.opencontainers.image.source="https://github.com/marcomarcogd/MRSS" \
      org.opencontainers.image.licenses="GPL-3.0"

# Install ca-certificates for HTTPS requests
RUN apk --no-cache add ca-certificates

# Create a non-root user
RUN adduser -D -s /bin/sh mrss

# Create data directory with proper permissions
RUN mkdir -p /app/data && chown -R mrss:mrss /app/data

# Set working directory
WORKDIR /app

# Copy the binary from builder stage
COPY --from=builder /app/mrss-server .
COPY --from=builder /app/LICENSE /app/NOTICE /usr/share/doc/MRSS/

# Change ownership
RUN chown mrss:mrss mrss-server

# Switch to non-root user
USER mrss

# Expose port
EXPOSE 1234

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:1234/api/version || exit 1

# Run the server
CMD ["./mrss-server", "-host", "0.0.0.0", "-port", "1234"]
